{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/codex_adapter.py\" push_guard.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/codex_adapter.py\" no_verify_guard.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/codex_adapter.py\" stash_guard.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/codex_adapter.py\" idle_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
