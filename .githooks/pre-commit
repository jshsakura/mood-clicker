#!/usr/bin/env bash
# Before a commit: block personal data, server details and secret files, then check Dart format and analysis.
# Install once with tool/setup.sh
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "> privacy and secret file scan"
python3 tool/privacy_scan.py --staged

echo "> slop scan (dashes, curly quotes, AI phrases, debug prints, flat style, Hangul in code)"
python3 tool/slop_scan.py --staged

echo "> l10n check (ARB parity, cheers shape)"
python3 tool/l10n_check.py

echo "> design tokens match generated files"
tool/check_snapshot.sh --index

DART=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart' | grep -v '\.g\.dart$' || true)
if [ -n "$DART" ]; then
  echo "▶ dart format, flutter analyze"
  # shellcheck disable=SC2086
  tool/fl_dart format --output=none --set-exit-if-changed $DART \
    || { echo "Format is off. Run tool/format.sh and stage again." >&2; exit 1; }
  tool/fl analyze --no-pub
fi
echo "ok: pre-commit"
