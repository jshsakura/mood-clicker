{
  "space": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "xxxl": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "24px"
    },
    "button": {
      "$type": "dimension",
      "$value": "16px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "Pretendard"
    },
    "brand": {
      "$type": "fontFamily",
      "$value": "Baloo2",
      "$description": "앱 이름 글자. 라틴 문자만 있다"
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": "34px",
        "fontWeight": "700",
        "lineHeight": "1.2"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": "22px",
        "fontWeight": "700",
        "lineHeight": "1.3"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.5"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "1.4"
      }
    },
    "count": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": "56px",
        "fontWeight": "700",
        "lineHeight": "1.0"
      }
    },
    "wordmark": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.brand}",
        "fontSize": "40px",
        "fontWeight": "800",
        "lineHeight": "1.1"
      }
    }
  },
  "motion": {
    "tap": {
      "$type": "duration",
      "$value": "90ms",
      "$description": "눌림 반응"
    },
    "fillRise": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "채움이 오를 때"
    },
    "page": {
      "$type": "duration",
      "$value": "240ms",
      "$description": "화면 전환"
    }
  }
}
