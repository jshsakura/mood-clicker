          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "22px",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.5"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "13px",
          "fontWeight": "400",
          "lineHeight": "1.4"
        }
      },
      "count": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "56px",
          "fontWeight": "700",
          "lineHeight": "1.0"
