      },
      "wordmark": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.brand}",
          "fontSize": "40px",
          "fontWeight": "800",
          "lineHeight": "1.1"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "12px",
          "fontWeight": "400",
          "lineHeight": "1.4"
        }
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "1.4"
        }
      },
      "cell": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "15px",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
