{
  "core": {
    "space": {
      "xs": {
        "$type": "dimension",
        "$value": "4px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "8px"
      },
      "md": {
        "$type": "dimension",
        "$value": "12px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "24px"
      },
      "xxl": {
        "$type": "dimension",
        "$value": "32px"
      },
      "xxxl": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "radius": {
      "card": {
        "$type": "dimension",
        "$value": "24px"
      },
      "button": {
        "$type": "dimension",
        "$value": "16px"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "Pretendard"
      },
      "brand": {
        "$type": "fontFamily",
        "$value": "Baloo2",
        "$description": "앱 이름 글자. 라틴 문자만 있다"
      }
    },
    "type": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "34px",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "22px",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.5"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "13px",
          "fontWeight": "400",
          "lineHeight": "1.4"
        }
      },
      "count": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family}",
          "fontSize": "56px",
          "fontWeight": "700",
          "lineHeight": "1.0"
        }
      },
      "wordmark": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.brand}",
          "fontSize": "40px",
          "fontWeight": "800",
          "lineHeight": "1.1"
        }
      }
    },
    "motion": {
      "tap": {
        "$type": "duration",
        "$value": "90ms",
        "$description": "눌림 반응"
      },
      "fillRise": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "채움이 오를 때"
      },
      "page": {
        "$type": "duration",
        "$value": "240ms",
        "$description": "화면 전환"
      }
    }
  },
  "dark": {
    "$extensions": {
      "app": {
        "brightness": "dark"
      }
    },
    "color": {
      "ground": {
        "$type": "color",
        "$value": "#121216",
        "$description": "화면 바탕"
      },
      "surface": {
        "$type": "color",
        "$value": "#222228",
        "$description": "카드, 배너 바탕"
      },
      "line": {
        "$type": "color",
        "$value": "#383840",
        "$description": "테두리, 구분선"
      },
      "ink": {
        "$type": "color",
        "$value": "#ECECF0",
        "$description": "본문 글자"
      },
      "inkMuted": {
        "$type": "color",
        "$value": "#A0A0AA",
        "$description": "보조 글자"
      },
      "ink2": {
        "$type": "color",
        "$value": "#C8C8D0",
        "$description": "본문 다음 단계의 글자색(보조 설명)"
      },
      "faint": {
        "$type": "color",
        "$value": "#6E6E78",
        "$description": "가장 옅은 글자와 선 아이콘(요일, 꺾쇠)"
      },
      "accent": {
        "$type": "color",
        "$value": "#ECECF0",
        "$description": "강조, 선택됨"
      },
      "onAccent": {
        "$type": "color",
        "$value": "#16161A",
        "$description": "강조 위의 글자"
      },
      "happy": {
        "$type": "color",
        "$value": "#FFC23D",
        "$description": "행복 쪽 기분"
      },
      "sad": {
        "$type": "color",
        "$value": "#7A9CFF",
        "$description": "슬픔 쪽 기분"
      },
      "fill": {
        "$type": "color",
        "$value": "#2A2A30",
        "$description": "두드리기 채움"
      },
      "onFill": {
        "$type": "color",
        "$value": "#ECECF0",
        "$description": "채움 위 글자"
      },
      "fillEdge": {
        "$type": "color",
        "$value": "#4A4A52",
        "$description": "Line on top of the fill"
      },
      "mapGround": {
        "$type": "color",
        "$value": "#121216",
        "$description": "지도 바탕"
      },
      "mapLine": {
        "$type": "color",
        "$value": "#383840",
        "$description": "지도 길, 경계선"
      },
      "error": {
        "$type": "color",
        "$value": "#F0685C",
        "$description": "오류"
      },
      "onError": {
        "$type": "color",
        "$value": "#16161A",
        "$description": "오류색 위 글자"
      }
    }
  },
  "light": {
    "$extensions": {
      "app": {
        "brightness": "light"
