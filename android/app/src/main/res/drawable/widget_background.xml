<?xml version="1.0" encoding="utf-8"?>
<!-- 24dp matches the card radius token (Radii.card). A hairline in the line color keeps the white
     card visible on a light wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_ground" />
    <stroke android:width="1dp" android:color="@color/widget_line" />
    <corners android:radius="24dp" />
</shape>
