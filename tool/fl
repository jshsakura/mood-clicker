#!/usr/bin/env bash
# Run Flutter. The flutter on PATH is used when it is the pinned version (see tool/flutter_env.sh);
# otherwise it runs in a docker image, so nothing has to be installed on the host.
# FL_DOCKER=1 forces docker. Each working tree uses its own Gradle volume so parallel builds do not
# wait on one lock; FL_GRADLE_VOLUME=<name> picks the volume by hand.
# Examples: tool/fl test, tool/fl analyze, tool/fl build apk --debug
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/tool/flutter_env.sh"

if use_local_flutter; then
  cd "$ROOT"
  exec flutter "$@"
fi

# An empty array under set -u fails on bash 3.2, hence the ${TTY[@]+...} form.
TTY=()
[ -t 1 ] && TTY=(-t)
exec docker run --rm ${TTY[@]+"${TTY[@]}"} \
  -v "$ROOT":/app \
  -v mood-clicker-pub-cache:/root/.pub-cache \
  -v "$(gradle_volume "$ROOT")":/root/.gradle \
  -w /app \
  -e OWNER="$(id -u):$(id -g)" \
  "$FLUTTER_IMAGE" \
  bash -c 'flutter "$@"; rc=$?; find /app -xdev -uid 0 -exec chown "$OWNER" {} + 2>/dev/null; exit $rc' -- "$@"
