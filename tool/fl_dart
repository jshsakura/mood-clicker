#!/usr/bin/env bash
# Run dart with the Flutter SDK inside Docker. Example: tool/fl_dart format lib
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="${FLUTTER_IMAGE:-ghcr.io/cirruslabs/flutter:3.44.0}"
exec docker run --rm -v "$ROOT":/app -v mood-clicker-pub-cache:/root/.pub-cache -w /app \
  -e OWNER="$(id -u):$(id -g)" "$IMAGE" \
  bash -c 'dart "$@"; rc=$?; find /app -xdev -uid 0 -exec chown "$OWNER" {} + 2>/dev/null; exit $rc' -- "$@"
